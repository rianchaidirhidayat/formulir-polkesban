rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Forms collection: allows employees to read form templates and administrators to edit
    match /forms/{formId} {
      allow read: if true;
      allow write: if true;
    }

    // Responses collection: allows all employees to submit responses and administrators to view analytics
    match /responses/{responseId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Health check and connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
